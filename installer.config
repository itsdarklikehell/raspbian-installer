# raspbian-installer configuration

# Dependencies to check/install
depends="wget unzip whiptail pv git curl"

# Raspbian image URLs
jessieurl="https://downloads.raspberrypi.org/raspbian/images/raspbian-2017-07-05/2017-07-05-raspbian-jessie.zip"
stretchurl="https://downloads.raspberrypi.org/raspbian/images/raspbian-2017-12-01/2017-11-29-raspbian-stretch.zip"

# Install command prefix
INSTLL="sudo apt-get install -y "
